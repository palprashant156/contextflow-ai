# Database
DATABASE_URL=postgresql://cortexflow:cortexflow_password@localhost:5432/cortexflow_db

# Security
JWT_SECRET=supersecret_dev_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Config (Set your provider here, e.g., OpenAI, Anthropic, Gemini)
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GEMINI_API_KEY=your_key_here

# Embeddings Config
